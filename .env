#DEBUG=False
#DEBUG=True
#MIN_SENTENCE_CHARS=20

# Comma-separated voice names/IDs to exclude from the pool entirely, regardless
# of TTS_ENGINE (e.g. a voice that turned out to sound wrong for its gender).
# See [VOICES] Male/Female at startup for the exact names/IDs to use here.
#EXCLUDED_VOICES=voice_id_1,voice_id_2

# Number of parallel TTS worker threads. Defaults to 15 for openai, 1 for
# xtts (a local model instance serializes anyway, so more workers just queue).
#TTS_WORKERS=15
#TTS_WORKERS=1

# --- TTS engine selection ---
#TTS_ENGINE=openai
#TTS_ENGINE=xtts
#TTS_ENGINE=elevenlabs

# --- openai engine settings (TTS_ENGINE=openai) ---
#OPENAI_API_KEY=...
#OPENAI_TTS_MODEL=tts-1
#OPENAI_TTS_MODEL=tts-1-hd
#OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- xtts engine settings (TTS_ENGINE=xtts), see https://github.com/daswer123/xtts-api-server ---
# Voices are fetched automatically from XTTS_API_URL/speakers_list; gender is
# inferred from each speaker name via a "female" substring check.
#XTTS_API_URL=http://localhost:8020
#XTTS_LANGUAGE=ru

# --- elevenlabs engine settings (TTS_ENGINE=elevenlabs) ---
# Voices are fetched automatically from your ElevenLabs account (GET /v1/voices);
# gender comes from ElevenLabs' own labels.gender field. Voices without that
# label are skipped entirely rather than guessed.
#ELEVENLABS_API_KEY=...
# eleven_turbo_v2_5/eleven_flash_v2_5 are the only models honoring ELEVENLABS_LANGUAGE below;
# other models (e.g. eleven_multilingual_v2) auto-detect language from the text instead.
#ELEVENLABS_MODEL=eleven_flash_v2_5
#ELEVENLABS_MODEL=eleven_turbo_v2_5
#ELEVENLABS_MODEL=eleven_multilingual_v2
#ELEVENLABS_MODEL=eleven_v3
#ELEVENLABS_LANGUAGE=ru
